<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 2.0//EN" "http://www.apple.com/DTDs/PropertyList-2.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.pmax.watcher</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PMAX_BIN__</string>
        <string>--stage-only</string>
        <string>watcher</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>3</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key><string>__PMAX_STATE__/logs/agent-watcher.log</string>
    <key>StandardErrorPath</key><string>__PMAX_STATE__/logs/agent-watcher.log</string>
</dict>
</plist>
